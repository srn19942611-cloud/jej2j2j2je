# --- Database ---
POSTGRES_DB=solarportal
POSTGRES_USER=solarportal
POSTGRES_PASSWORD=solarportal
# Used when running the backend outside docker-compose (points at localhost:5433 published port)
DATABASE_URL=postgresql+psycopg2://solarportal:solarportal@localhost:5433/solarportal

# --- Weather (Open-Meteo: free, no API key required) ---
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# --- Connector modes ---
# "mock" (default) runs the built-in weather-correlated simulator with no external calls.
# "live" switches that platform's connector to call the real vendor API using the
# credentials below. Flipping to live requires ONLY these env vars - no code changes.
FUSIONSOLAR_MODE=mock
SOLPLANET_MODE=mock
SOLAX_MODE=mock

# FusionSolar (Huawei Northbound OpenAPI) - whitelisted app credentials
FUSIONSOLAR_BASE_URL=https://eu5.fusionsolar.huawei.com
FUSIONSOLAR_USERNAME=
FUSIONSOLAR_PASSWORD=

# SolPlanet - UNVERIFIED connector, built against the Sofar Solar OpenAPI rebrand spec.
# Confirm the current API shape/branding with the vendor before trusting live mode.
SOLPLANET_BASE_URL=https://api.solplanet.example
SOLPLANET_APP_ID=
SOLPLANET_APP_SECRET=

# SolaX - two possible auth schemes, auto-selected by which credentials are set (see
# app/connectors/solax/live.py). Set ONE of the two blocks below, not both.
#
# 1) Legacy SolaX Cloud "User Monitoring API" - a static tokenId (well-documented publicly).
SOLAX_BASE_URL=https://www.solaxcloud.com/proxyApp/proxy/api
SOLAX_TOKEN_KEY=
#
# 2) Newer SolaX "Developer Portal" (developer.solaxcloud.com) - Client ID/Secret from the
# portal's Authorization tab. UNVERIFIED: the token/data endpoint URLs below are a
# best-effort OAuth2 client_credentials guess, not confirmed against the real API - see
# the module docstring in app/connectors/solax/live.py before trusting live mode.
SOLAX_CLIENT_ID=
SOLAX_CLIENT_SECRET=
SOLAX_OAUTH_TOKEN_URL=https://developer.solaxcloud.com/oauth/token
SOLAX_OAUTH_DATA_BASE_URL=https://developer.solaxcloud.com/api/v1

# --- API ---
API_CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
