{
  "expo": {
    "name": "Sundhed",
    "slug": "health-app",
    "scheme": "sundhed",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.privat.sundhed",
      "adaptiveIcon": {
        "backgroundColor": "#E8EEFB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.WRITE_WEIGHT",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.WRITE_NUTRITION",
        "android.permission.health.READ_NUTRITION"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.privat.sundhed"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "react-native-health-connect",
      [
        "expo-image-picker",
        {
          "photosPermission": "Appen bruger dine billeder til at analysere måltider og tilbudsaviser.",
          "cameraPermission": "Appen bruger kameraet til at tage billeder af måltider og tilbudsaviser."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
